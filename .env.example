# Copia in .env.local per lo sviluppo e imposta i valori (mai committare .env.local).
# In locale i valori vengono da `supabase status`. Su Vercel si impostano
# separatamente per Preview (progetto Supabase staging) e Production.

# --- Supabase (client + server) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# chiave anon / publishable: è pubblica, la protezione la fa la RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Solo server: MAI con prefisso NEXT_PUBLIC_ ---
# service role / secret key: usata solo da POST /api/questions
SUPABASE_SERVICE_ROLE_KEY=
# sale per gli hash antispam, almeno 32 byte casuali: openssl rand -hex 32
# diverso per Preview e Production, da ruotare dopo l'evento
SUBMIT_SALT=

# --- Sito ---
# URL pubblico di PRODUZIONE codificato nel QR (anche nelle preview)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Facoltative ---
# tetto di invii al minuto per IP (wifi condiviso del locale), default 30
RATE_LIMIT_IP_PER_MINUTE=
# "false" chiude la raccolta domande (kill switch, serve un redeploy), default true
SUBMISSIONS_OPEN=

# --- Solo test e2e / load test contro la preview (non servono all'app) ---
E2E_BASE_URL=
VERCEL_AUTOMATION_BYPASS_SECRET=
